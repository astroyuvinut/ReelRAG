# copy this file to .env in the backend folder and fill in your real key.
# get one for free at https://aistudio.google.com/app/apikey

GEMINI_API_KEY=AIza_paste_your_key_here

# instagram requires login cookies for most reels. supply ONE of these:
#  - a Netscape cookies.txt exported from your browser (most reliable on windows):
# IG_COOKIES_FILE=./ig_cookies.txt
#  - or pull cookies live from a browser (chrome/firefox/edge/brave).
#    note: chrome v127+ may block this (yt-dlp #7271); close the browser first.
# IG_COOKIES_BROWSER=firefox

# instagram doesn't expose view counts, so engagement rate shows N/A for reels.
# set this to 1 to try instaloader as a fallback for views. off by default
# because instagram currently blocks instaloader (400), so it just adds latency.
# IG_FETCH_VIEWS=0
